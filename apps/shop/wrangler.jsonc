// Production deploy of the shop: the built Vite app (dist/) served as static assets, plus a tiny
// Worker (worker/index.ts) that forwards /api/* to the API Worker. Local dev doesn't use this
// file: `pnpm dev:shop` runs Vite and talks to `pnpm dev:api` directly.
// Deploy: `pnpm --filter @novap/shop run deploy` (builds first). The API Worker must exist first.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novap-shop",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    // Unknown paths (e.g. /products/reference-02 on reload) get index.html; React Router takes over.
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker; everything else is served straight from the assets.
    "run_worker_first": ["/api/*"]
  },
  // The API Worker (apps/api, env.production name). No public URL of its own.
  "services": [{ "binding": "API", "service": "novap-api" }]
}

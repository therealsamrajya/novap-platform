// Cloudflare Worker config. "Bindings" listed here appear on `env` in code:
//   env.DB      -> D1 database (SQLite)
//   env.BUCKET  -> R2 bucket (product images)
// In `wrangler dev` everything runs locally (stored in .wrangler/), so no
// Cloudflare account is needed until deploy. The database_id below is a
// placeholder; replace it with the real id from `wrangler d1 create` before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novap-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "APP_ENV": "development",
    "SHOP_URL": "http://localhost:5173",
    "ADMIN_URL": "http://localhost:5174",
    // Shipping in cents (AUD, GST-inclusive): flat rate, free from the threshold up.
    "SHIPPING_FLAT_CENTS": "995",
    "FREE_SHIPPING_FROM_CENTS": "15000",
    // Sender for all emails. onboarding@resend.dev works without a verified domain,
    // but Resend then only delivers to the Resend account owner's own address.
    "EMAIL_FROM": "NŌVAP <onboarding@resend.dev>",
    // Where contact form notifications go.
    "ADMIN_NOTIFY_EMAIL": "admin@novap.local"
  },

  // Secrets (values in .dev.vars locally, `wrangler secret put` in production).
  // Listing them here types them on `env` and makes `wrangler dev` warn when one is missing.
  "secrets": {
    "required": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "RESEND_API_KEY"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novap-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "novap-images"
    }
  ]
}

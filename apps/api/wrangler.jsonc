// Cloudflare Worker config. "Bindings" listed here appear on `env` in code:
//   env.DB      -> D1 database (SQLite)
//   env.BUCKET  -> R2 bucket (product images)
// In `wrangler dev` everything runs locally (stored in .wrangler/), so no
// Cloudflare account is needed until deploy. The database_id below is a
// placeholder; replace it with the real id from `wrangler d1 create` before deploying.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "novap-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "vars": {
    "APP_ENV": "development",
    "SHOP_URL": "http://localhost:5173",
    "ADMIN_URL": "http://localhost:5174",
    // Shipping in cents (AUD, GST-inclusive): flat rate, free from the threshold up.
    "SHIPPING_FLAT_CENTS": "995",
    "FREE_SHIPPING_FROM_CENTS": "15000",
    // Sender for all emails. onboarding@resend.dev works without a verified domain,
    // but Resend then only delivers to the Resend account owner's own address.
    "EMAIL_FROM": "NŌVAP <onboarding@resend.dev>",
    // Where contact form notifications go.
    "ADMIN_NOTIFY_EMAIL": "admin@novap.local"
  },

  // Secrets (values in .dev.vars locally, `wrangler secret put` in production).
  // Listing them here types them on `env` and makes `wrangler dev` warn when one is missing.
  "secrets": {
    "required": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "RESEND_API_KEY"]
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "novap-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "src/db/migrations"
    }
  ],

  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "novap-images"
    }
  ],

  // Cloudflare's built-in rate limiter (middleware/rate-limit.ts). Counters are kept per
  // Cloudflare location and the period can only be 10 or 60 seconds. namespace_id is any
  // number unique within the account; each namespace counts separately.
  "ratelimits": [
    // Login, register, checkout: 10 per minute per IP.
    { "name": "RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    // Endpoints that send email or are easy to abuse: 5 per minute per IP.
    { "name": "RATE_LIMIT_STRICT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }
  ],

  // Scheduled clean-up (src/scheduled.ts): stale pending orders, expired sessions and tokens.
  // Locally: `pnpm dev` runs with --test-scheduled; trigger it with
  // curl "http://localhost:8787/cdn-cgi/handler/scheduled".
  "triggers": {
    "crons": ["*/15 * * * *"]
  },

  // ---------------------------------------------------------------- production
  // Deployed with `pnpm --filter @novap/api run deploy` (= wrangler deploy --env production).
  // (`run` is needed: plain `pnpm deploy` is a built-in pnpm command, not this script.)
  // Bindings and vars are not inherited from the top level, so each one is repeated here.
  // See docs/deploy.md for creating the D1 database, R2 bucket and secrets.
  "env": {
    "production": {
      // Fixed name: the shop and admin Workers reach the API through a service binding to it.
      "name": "novap-api",
      // No public URL. Browsers reach the API through the shop and admin Workers, which forward
      // /api/* (same origin, so the session cookie and image headers work on workers.dev too).
      // Stripe's webhook goes through the shop as well: https://<shop>/api/stripe/webhook.
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true },
      "vars": {
        "APP_ENV": "production",
        // The shop and admin Workers' URLs. Until there is a domain: their workers.dev addresses,
        // printed by their first deploy. Used for CORS/csrf, Stripe redirects and email links.
        "SHOP_URL": "https://novap-shop.samrajyabahadurchand.workers.dev",
        "ADMIN_URL": "https://novap-admin.samrajyabahadurchand.workers.dev",
        "SHIPPING_FLAT_CENTS": "995",
        "FREE_SHIPPING_FROM_CENTS": "15000",
        // Resend only delivers to the account owner's address until a domain is verified.
        "EMAIL_FROM": "NŌVAP <onboarding@resend.dev>",
        "ADMIN_NOTIFY_EMAIL": "samrajyadai@gmail.com"
      },
      // Set with `wrangler secret put <NAME> --env production`.
      "secrets": {
        "required": ["STRIPE_SECRET_KEY", "STRIPE_WEBHOOK_SECRET", "RESEND_API_KEY"]
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "novap-db-production",
          // From `wrangler d1 create novap-db-production`.
          "database_id": "8e4b1937-00df-42e1-926e-dcbf0608c2ca",
          "migrations_dir": "src/db/migrations"
        }
      ],
      "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "novap-images-production" }],
      // Separate namespace ids from local dev, so the counters never mix.
      "ratelimits": [
        { "name": "RATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMIT_STRICT", "namespace_id": "2002", "simple": { "limit": 5, "period": 60 } }
      ],
      "triggers": { "crons": ["*/15 * * * *"] }
    }
  }
}

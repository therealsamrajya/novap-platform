# Local secrets for `wrangler dev`. Copy to .dev.vars (gitignored) and fill in.
# In production these are set with: wrangler secret put <NAME>

# Stripe test mode (https://dashboard.stripe.com/test/apikeys).
# The webhook secret is printed by: stripe listen --forward-to localhost:8787/api/stripe/webhook
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Resend (https://resend.com/api-keys). Leave empty to print emails to the
# `pnpm dev:api` console instead of sending them.
RESEND_API_KEY=

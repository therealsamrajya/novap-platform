{
  "name": "@novap/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply novap-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply novap-db --remote",
    "db:seed:local": "wrangler d1 execute novap-db --local --file=src/db/seed.sql",
    "db:reset:local": "node scripts/reset-local-db.mjs && pnpm db:migrate:local && pnpm db:seed:local"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.2",
    "@hono/zod-openapi": "^1.6.3",
    "@novap/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.14",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11",
    "typescript": "5.9.3",
    "wrangler": "^4.130.0"
  }
}
